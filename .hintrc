{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "gap",
          "justify-content",
          "background-position: right",
          "flex-direction",
          "align-items",
          "background-position: center right",
          "background-position: 70% center",
          "-webkit-overflow-scrolling"
        ]
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not ie <= 11"
  ]
}